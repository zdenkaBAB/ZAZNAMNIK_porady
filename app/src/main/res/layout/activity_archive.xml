<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/archiveBack" android:text="‹ Späť" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="Archív nahrávok" android:textSize="22sp" android:textStyle="bold" android:layout_marginStart="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <TextView android:id="@+id/archiveEmpty" android:text="Zatiaľ nemáš uložené žiadne nahrávky." android:gravity="center" android:padding="24dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/archiveList" android:orientation="vertical" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </ScrollView>
</LinearLayout>
