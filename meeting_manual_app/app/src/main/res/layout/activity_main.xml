<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="MEETING MANUAL" android:textSize="26sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:text="Lokálny záznamník pracovných stretnutí" android:textSize="14sp" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/title" android:hint="Názov stretnutia" android:singleLine="true" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/timer" android:text="00:00:00" android:textSize="42sp" android:gravity="center" android:layout_marginTop="28dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/record" android:text="🔴  ZAČAŤ NAHRÁVANIE" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/stop" android:text="⏹  UKONČIŤ" android:enabled="false" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/transcribe" android:text="📝  PREPIS – lokálne rozpoznávanie" android:enabled="false" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/manual" android:text="📑  VYTVORIŤ PRACOVNÝ MANUÁL" android:enabled="false" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/export" android:text="📄  EXPORTOVAŤ WORD" android:enabled="false" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/status" android:text="Pripravené. Zvuk zostáva v telefóne." android:textSize="14sp" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/transcript" android:text="Prepis sa bude zobrazovať tu." android:textSize="16sp" android:padding="12dp" android:background="#F2F4F7" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout></ScrollView>
